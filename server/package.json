{
  "name": "server",
  "version": "1.0.0",
  "description": "BCBE Votes backend service (Express + Drizzle + Postgres)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "import:meetings": "tsx src/scripts/importMeetingListing.ts",
    "import:meeting-detail": "tsx src/scripts/importMeetingDetail.ts",
    "import:search-meetings": "tsx src/scripts/importSearchMeetings.ts",
    "probe:agenda-item": "tsx src/scripts/probeAgendaItem.ts",
    "probe:agenda-tree": "tsx src/scripts/probeAgendaTree.ts",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "npm run typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.15.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.1",
    "dotenv-expand": "^12.0.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/pino": "^7.0.4",
    "@types/pino-http": "^5.8.4",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
